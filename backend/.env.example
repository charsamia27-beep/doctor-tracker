# ── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── MongoDB (local, Docker or Atlas) ────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/doctor_tracker

# ── Auth ────────────────────────────────────────────────
# Generate with: openssl rand -base64 48   (the server refuses this example value in production)
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=8h
JWT_ISSUER=doctor-tracker-api
JWT_AUDIENCE=doctor-tracker-web
COOKIE_NAME=dt_token
CSRF_COOKIE_NAME=dt_csrf

# Brute-force protection: lock an account for N minutes after M failed logins
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Audit logs are auto-deleted after this many days (MongoDB TTL index)
AUDIT_RETENTION_DAYS=180

# ── CORS / CSRF: comma-separated list of allowed frontend origins ──
CLIENT_ORIGIN=http://localhost:3000

# ── Seed admin (used by `npm run seed`) ─────────────────
SEED_ADMIN_EMAIL=admin@doctortracker.com
SEED_ADMIN_PASSWORD=Admin@12345
