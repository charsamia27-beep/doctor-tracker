# Where the Express API runs. Next.js proxies /api/* to this URL (see next.config.mjs),
# so the auth cookie is first-party and the browser never talks to the API origin directly.
API_URL=http://localhost:5000

# Same values as the backend. When JWT_SECRET is set, middleware verifies the token
# signature, issuer, audience and expiry at the edge before rendering any protected page.
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_ISSUER=doctor-tracker-api
JWT_AUDIENCE=doctor-tracker-web
COOKIE_NAME=dt_token
